{
  "name": "sparsi-ts",
  "version": "0.1.0",
  "description": "An idiomatic TypeScript DAG-workflow framework with deterministic and AI-backed operators.",
  "license": "BSD-3-Clause",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:skills": "tsx tools/genskills.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "example:ticket": "tsx examples/ticket_triager/main.ts",
    "example:recipe": "tsx examples/recipe_analyzer/main.ts",
    "example:stock": "tsx examples/stock_analyzer/main.ts",
    "example:stock-v2": "tsx examples/stock_analyzer_v2/main.ts",
    "example:weather": "tsx examples/weather_advisor/main.ts",
    "example:repair": "tsx examples/with_repair/main.ts",
    "example:repair-json": "tsx examples/repair_json/main.ts",
    "example:faithful": "tsx examples/faithful_summary/main.ts",
    "example:hn": "tsx examples/hn_topic_brief/main.ts",
    "example:readme": "tsx examples/readme_quality/main.ts",
    "example:local-mcp": "tsx examples/local_mcp_server/main.ts",
    "example:remote-mcp": "tsx examples/remote_mcp_server/main.ts",
    "example:rag-basic": "tsx examples/rag_basic/main.ts",
    "example:rag-bm25": "tsx examples/rag_bm25/main.ts",
    "example:rag-gemini-embed": "tsx examples/rag_gemini_embed/main.ts",
    "example:smart-doc": "tsx examples/smart_doc_assistant/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@google/genai": "^2.8.0",
    "@langchain/core": "^1.2.1",
    "@langchain/google-genai": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^5.8.0",
    "langchain": "^1.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
